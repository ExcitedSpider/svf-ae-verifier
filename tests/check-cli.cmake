cmake_minimum_required(VERSION 3.20)
include("${CMAKE_CURRENT_LIST_DIR}/test-helpers.cmake")
compile_case()
run_verifier(2 "" -property=invalid "${work}/input.ll")
run_verifier(2 "" -property=reach -unknown-option "${work}/input.ll")
run_verifier(2 "" -property=reach -ae-sparsity=invalid "${work}/input.ll")
run_verifier(2 "" -property=reach "${work}/input.ll" -o)
run_verifier(1 "" -property=reach "${work}/missing.ll")
run_verifier(1 "" -property=reach "${case}")
run_verifier(1 "" -property=reach "${work}/input.ll" -o "${work}/missing/report.json")

set(output_file "${work}/report.json")
run_verifier(0 ok -property=reach,overflow "${work}/input.ll" -o "${output_file}")
string(JSON reach GET "${report}" properties reach)
string(JSON overflow GET "${report}" properties overflow)
if(NOT reach STREQUAL "unproved" OR NOT overflow STREQUAL "proved")
    message(FATAL_ERROR "Unexpected program verdicts\n${report}")
endif()
