cmake_minimum_required(VERSION 3.20)
include("${CMAKE_CURRENT_LIST_DIR}/test-helpers.cmake")
compile_case()
run_verifier(0 ok "-property=${property}" "-ae-sparsity=${mode}" "${work}/input.ll")

get_filename_component(case_name "${case}" NAME)
string(JSON actual_mode GET "${report}" ae_mode)
if(NOT actual_mode STREQUAL mode)
    message(FATAL_ERROR "Expected AE mode ${mode}, got ${actual_mode}")
endif()
file(STRINGS "${case}" expectations REGEX "// EXPECT: ")
foreach(line IN LISTS expectations)
    if(NOT line MATCHES "// EXPECT: line ([0-9]+) ([a-z_]+) (proved|unproved) ([a-z-]+)$")
        message(FATAL_ERROR "Malformed expectation: ${line}")
    endif()
    list(APPEND expected "${CMAKE_MATCH_1} ${CMAKE_MATCH_2} ${CMAKE_MATCH_3} ${CMAKE_MATCH_4}")
endforeach()
string(JSON count LENGTH "${report}" sites)
set(program_verdict proved)
set(index 0)
while(index LESS count)
    foreach(field IN ITEMS kind verdict reason property)
        string(JSON site_${field} GET "${report}" sites "${index}" "${field}")
    endforeach()
    foreach(field IN ITEMS file line column function)
        string(JSON source_${field} GET "${report}" sites "${index}" location "${field}")
    endforeach()
    get_filename_component(source_name "${source_file}" NAME)
    if(NOT site_property STREQUAL property OR NOT source_name STREQUAL case_name
        OR source_column LESS 1 OR NOT source_function STREQUAL "main")
        message(FATAL_ERROR "Unexpected property or source location\n${report}")
    endif()
    list(APPEND actual "${source_line} ${site_kind} ${site_verdict} ${site_reason}")
    if(site_verdict STREQUAL "unproved")
        set(program_verdict unproved)
    endif()
    math(EXPR index "${index} + 1")
endwhile()
list(SORT actual)
list(SORT expected)
string(JSON actual_program_verdict GET "${report}" properties "${property}")
if(NOT actual STREQUAL expected OR NOT actual_program_verdict STREQUAL program_verdict)
    message(FATAL_ERROR "Expected ${expected}, got ${actual}\n${report}")
endif()
